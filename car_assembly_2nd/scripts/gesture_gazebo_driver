#!/usr/bin/env python3
import json
import math
import socket
import threading
import time

import rclpy
from gazebo_msgs.msg import EntityState
from gazebo_msgs.srv import GetEntityState, SetEntityState
from geometry_msgs.msg import Twist
from rclpy.node import Node


VALID_COMMANDS = {"STOP", "FORWARD", "BACKWARD", "LEFT", "RIGHT"}


def yaw_from_quaternion(q):
    siny_cosp = 2.0 * (q.w * q.z + q.x * q.y)
    cosy_cosp = 1.0 - 2.0 * (q.y * q.y + q.z * q.z)
    return math.atan2(siny_cosp, cosy_cosp)


class GestureGazeboDriver(Node):
    def __init__(self):
        super().__init__("gesture_gazebo_driver")

        self.declare_parameter("model_name", "car_assembly_2nd")
        self.declare_parameter("udp_host", "0.0.0.0")
        self.declare_parameter("udp_port", 4210)
        self.declare_parameter("command_timeout", 1.0)
        self.declare_parameter("forward_speed", 0.35)
        self.declare_parameter("backward_speed", -0.25)
        self.declare_parameter("turn_speed", 1.8)

        self.model_name = self.get_parameter("model_name").value
        self.udp_host = self.get_parameter("udp_host").value
        self.udp_port = int(self.get_parameter("udp_port").value)
        self.command_timeout = float(self.get_parameter("command_timeout").value)
        self.forward_speed = float(self.get_parameter("forward_speed").value)
        self.backward_speed = float(self.get_parameter("backward_speed").value)
        self.turn_speed = float(self.get_parameter("turn_speed").value)

        self._lock = threading.Lock()
        self._latest_command = "STOP"
        self._latest_payload = {}
        self._last_packet_time = 0.0
        self._last_logged_command = None
        self._request_in_flight = False
        self._stop_event = threading.Event()

        self._sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self._sock.settimeout(0.2)
        self._sock.bind((self.udp_host, self.udp_port))
        self._listener_thread = threading.Thread(target=self._udp_listener, daemon=True)
        self._listener_thread.start()

        self.get_entity_client = self.create_client(GetEntityState, "/get_entity_state")
        self.set_entity_client = self.create_client(SetEntityState, "/set_entity_state")

        self.get_logger().info(f"Listening for UDP commands on {self.udp_host}:{self.udp_port}")
        self.get_logger().info(f"Controlling Gazebo model '{self.model_name}'")
        self._wait_for_gazebo_services()

        self.timer = self.create_timer(0.05, self._on_timer)

    def _wait_for_gazebo_services(self):
        while rclpy.ok():
            get_ready = self.get_entity_client.wait_for_service(timeout_sec=1.0)
            set_ready = self.set_entity_client.wait_for_service(timeout_sec=1.0)
            if get_ready and set_ready:
                self.get_logger().info("Gazebo entity state services are ready")
                return
            self.get_logger().info(
                "Waiting for /get_entity_state and /set_entity_state. "
                "Start Gazebo with the car_assembly_2nd gesture_empty.world file."
            )

    def _udp_listener(self):
        while not self._stop_event.is_set():
            try:
                data, _addr = self._sock.recvfrom(4096)
            except socket.timeout:
                continue
            except OSError:
                return

            try:
                payload = json.loads(data.decode("utf-8"))
            except (UnicodeDecodeError, json.JSONDecodeError):
                self.get_logger().warn("Ignoring malformed UDP command packet")
                continue

            cmd = str(payload.get("cmd", "")).upper()
            if cmd not in VALID_COMMANDS:
                self.get_logger().warn(f"Ignoring unsupported command '{cmd}'")
                continue

            with self._lock:
                self._latest_command = cmd
                self._latest_payload = payload
                self._last_packet_time = time.monotonic()

    def _current_command(self):
        with self._lock:
            age = time.monotonic() - self._last_packet_time if self._last_packet_time else float("inf")
            command = self._latest_command if age <= self.command_timeout else "STOP"
            payload = dict(self._latest_payload)

        if command != self._last_logged_command:
            self._last_logged_command = command
            source = payload.get("gesture", "timeout" if command == "STOP" else "")
            self.get_logger().info(f"Active command: {command} source={source}")

        return command

    def _on_timer(self):
        if self._request_in_flight:
            return

        self._request_in_flight = True
        request = GetEntityState.Request()
        request.name = self.model_name
        request.reference_frame = "world"
        future = self.get_entity_client.call_async(request)
        future.add_done_callback(self._on_get_entity_state)

    def _on_get_entity_state(self, future):
        try:
            response = future.result()
        except Exception as exc:
            self._request_in_flight = False
            self.get_logger().warn(f"Failed to get entity state: {exc}")
            return

        if not response.success:
            self._request_in_flight = False
            self.get_logger().warn(f"Gazebo could not find entity '{self.model_name}'")
            return

        command = self._current_command()
        state = EntityState()
        state.name = self.model_name
        state.reference_frame = "world"
        state.pose = response.state.pose
        state.twist = self._twist_for_command(command, response.state.pose.orientation)

        request = SetEntityState.Request()
        request.state = state
        future = self.set_entity_client.call_async(request)
        future.add_done_callback(self._on_set_entity_state)

    def _on_set_entity_state(self, future):
        try:
            response = future.result()
            if not response.success:
                self.get_logger().warn("Gazebo rejected SetEntityState request")
        except Exception as exc:
            self.get_logger().warn(f"Failed to set entity state: {exc}")
        finally:
            self._request_in_flight = False

    def _twist_for_command(self, command, orientation):
        twist = Twist()
        yaw = yaw_from_quaternion(orientation)

        if command == "FORWARD":
            speed = self.forward_speed
            twist.linear.x = speed * math.cos(yaw)
            twist.linear.y = speed * math.sin(yaw)
        elif command == "BACKWARD":
            speed = self.backward_speed
            twist.linear.x = speed * math.cos(yaw)
            twist.linear.y = speed * math.sin(yaw)
        elif command == "LEFT":
            twist.angular.z = self.turn_speed
        elif command == "RIGHT":
            twist.angular.z = -self.turn_speed

        return twist

    def destroy_node(self):
        self._stop_event.set()
        try:
            self._sock.close()
        except OSError:
            pass
        return super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    node = GestureGazeboDriver()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
